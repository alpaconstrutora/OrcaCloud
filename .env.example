# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# WhatsApp Cloud API (Meta): o TOKEN NÃO entra aqui. Toda variável VITE_* vai para o
# bundle público. Cada organização cadastra o seu token em Configurações › WhatsApp &
# Integrações; ele fica no Vault e só a Edge Function `whatsapp-cloud` lê (achado F75).
# Opcional: nome sugerido do template de "pedido enviado" no formulário.
# VITE_WA_TEMPLATE_ORDER_SENT=opura_pedido_enviado

# Gemini (desabilitado — deixar como PLACEHOLDER para não habilitar acidentalmente)
GEMINI_API_KEY=PLACEHOLDER_API_KEY
