# OpenWA + worker — copie para .env (cp .env.example .env) e preencha.
# O .env NUNCA vai para o git (infra/openwa/.env está no .gitignore). Ver LEIA-ME.md.
# Gerar segredos: openssl rand -hex 32

# ── Imagens ──────────────────────────────────────────────────────────────────
# Digest da imagem do OpenWA v0.31.0 (com o prefixo sha256:). Como obter: LEIA-ME, "Fixar a imagem".
OPENWA_DIGEST=
# Opcional: imagem base do worker fixada por digest, ex.: node:22-alpine@sha256:...
# Vazio = node:22-alpine (tag).
WORKER_NODE_IMAGE=

# ── OpenWA ───────────────────────────────────────────────────────────────────
# Chave ADMIN inicial do OpenWA (lida só no 1º boot; >= 32 caracteres). Usada só nos
# comandos de instalação (criar sessão, chave do worker, webhook). Mudar depois não tem efeito.
API_MASTER_KEY=
# Chave OPERATOR do worker, limitada à sessão (criada no passo "Chave do worker" do LEIA-ME).
OPENWA_API_KEY=
# Nome da sessão no OpenWA (o worker acha o id por ele).
OPENWA_SESSAO_NOME=opura
# Segredo de assinatura do webhook (HMAC). O MESMO valor do secret OPENWA_WEBHOOK_SECRET
# da Edge Function whatsapp-openwa-webhook. Não vai para nenhum container: só para o
# comando que registra o webhook.
OPENWA_WEBHOOK_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://oxedkknreghxrgenyjiu.supabase.co
# Chave pública (anon) do projeto — só para ouvir a campainha (Realtime).
SUPABASE_ANON_KEY=
# O MESMO valor do secret WA_WORKER_SECRET da Edge Function whatsapp-openwa-worker (>= 32 caracteres).
WA_WORKER_SECRET=
